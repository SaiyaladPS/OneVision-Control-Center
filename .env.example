# Shared Car Scan / OneVision PostgreSQL dataset
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/car_scan

# OneVision scan archive. Defaults to ../OneVison/scan/data in local development.
ONEVISION_DATA_ROOT=../OneVison/scan/data

# Session Secret (must be at least 32 characters, generate a random string)
NUXT_SESSION_PASSWORD=your-random-secret-at-least-32-chars

# OneVision real-time event stream
NUXT_PUBLIC_ONE_VISION_WEBSOCKET_URL=ws://localhost:8000/ws

# AES Encryption Secret Key (used for encrypting passwords in transit)
# Must be the same value in both frontend and backend runtime configuration.
SECRET_KEY=your-random-secret-key
NUXT_PUBLIC_PASSWORD_ENCRYPTION_KEY=your-random-secret-key

# CVAT read-only integration for the Reports page
CVAT_BASE_URL=https://cvat.example.com
CVAT_USERNAME=your-cvat-username
CVAT_PASSWORD=your-cvat-password
# Set false only when the internal CVAT certificate chain is not trusted by Node.js.
CVAT_TLS_REJECT_UNAUTHORIZED=true
